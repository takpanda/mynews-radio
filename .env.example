# App
APP_ENV=development
API_PORT=8010
WEB_PORT=3010

# Cron (daily batch) - format: minute hour day-of-month month day-of-week (UTC)
CRON_SCHEDULE=0 21 * * *

# Backend
DATABASE_URL=sqlite:////app/data/mynews-radio.db
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3010,https://radio.beeworks.cc

# Frontend
API_BASE=http://api:8010
NEXT_PUBLIC_API_BASE=http://localhost:8010

# API key authentication (empty = disabled)
API_KEY=
# 検証済みクライアントIPのリレー署名検証用HMAC秘密鍵。
# 公開入口(Nginx)が付与したX-Verified-Client-IPを、Next.jsのリレーが署名しバックエンドが検証する。
# Next.js(web)とバックエンド(api)で同一の値を設定する。値は公開しない。
PROXY_CLIENT_IP_HMAC_SECRET=
# 公開入口(Nginx)がリクエストへ付与する秘密のトラストマーカー(X-Public-Entry)。
# docker-composeのproxyサービスで必須。Next.jsはこのマーカーが一致するときだけIPをリレー署名する。値は公開しない。
PUBLIC_ENTRY_TOKEN=

# External services (DGX side)
DGX_HOST=127.0.0.1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:27b
VOICEVOX_BASE_URL=http://127.0.0.1:50021

# Rate limiting
# 生成系API(/generate, /synthesize)のリクエストレート制限（管理者セッション単位）
GENERATE_RATE_LIMIT=5/minute
# 同時実行・日次上限（利用者別/IP別/全体）は固定値のため変更不可。
# 詳細はREADME「エピソード生成リクエスト」「監査ログ」「公開入口」を参照。

# VOICEVOX speakers (speaker ID for male/female voices)
VOICEVOX_SPEAKER_MALE=21
VOICEVOX_SPEAKER_FEMALE=20

# Web Push (VAPID)
# VAPID_PUBLIC_KEY=  # 未設定時は購読APIが503を返す
# VAPID_PRIVATE_KEY= # 秘密情報、ログに出力しない
# VAPID_CLAIMS_EMAIL= # VAPID_PRIVATE_KEYと併せて設定必須

# Push rate limiting
# PUSH_RATE_LIMIT=30/minute
